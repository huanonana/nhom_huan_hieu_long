<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- Cleartext is allowed only for the Android Emulator's host loopback
         alias, used by the local-only Gemini demo proxy on the development PC. -->
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">10.0.2.2</domain>
    </domain-config>
</network-security-config>
