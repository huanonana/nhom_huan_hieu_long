rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    // Development/classroom rules only: public reads and authenticated writes
    // keep iteration simple. They are intentionally not suitable for production.
    match /{document=**} {
      allow read: if true;
      allow write: if signedIn();
    }
  }
}
