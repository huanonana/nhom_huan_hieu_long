rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isSelf(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function isHost() {
      return signedIn()
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'host';
    }

    function ownsHome(homestayId) {
      return isHost()
        && get(/databases/$(database)/documents/homestays/$(homestayId)).data.hostId == request.auth.uid;
    }

    match /users/{uid} {
      allow read: if isSelf(uid);
      allow create: if isSelf(uid)
        && request.resource.data.uid == uid
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.displayName is string
        && request.resource.data.role in ['guest', 'host']
        && request.resource.data.createdAt is timestamp;
      allow update: if isSelf(uid)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['displayName', 'email'])
        && request.resource.data.email == request.auth.token.email;
      allow delete: if false;
    }

    match /homestays/{homestayId} {
      allow read: if true;
      allow create: if isHost() && request.resource.data.hostId == request.auth.uid;
      allow update: if isHost()
        && resource.data.hostId == request.auth.uid
        && request.resource.data.hostId == request.auth.uid;
      allow delete: if isHost() && resource.data.hostId == request.auth.uid;
    }

    match /rooms/{roomId} {
      allow read: if true;
      allow create: if ownsHome(request.resource.data.homestayId);
      allow update: if ownsHome(resource.data.homestayId)
        && request.resource.data.homestayId == resource.data.homestayId;
      allow delete: if ownsHome(resource.data.homestayId);
    }

    match /bookings/{bookingId} {
      allow read: if signedIn()
        && (resource.data.guestId == request.auth.uid || resource.data.hostId == request.auth.uid);
      allow create: if signedIn()
        && request.resource.data.guestId == request.auth.uid
        && request.resource.data.status == 'pending'
        && request.resource.data.roomId is string
        && request.resource.data.homestayId is string
        && exists(/databases/$(database)/documents/rooms/$(request.resource.data.roomId))
        && get(/databases/$(database)/documents/rooms/$(request.resource.data.roomId)).data.homestayId == request.resource.data.homestayId
        && get(/databases/$(database)/documents/homestays/$(request.resource.data.homestayId)).data.hostId == request.resource.data.hostId;
      allow update: if signedIn()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status'])
        && ((resource.data.guestId == request.auth.uid
              && resource.data.status == 'pending'
              && request.resource.data.status == 'cancelled')
            || (resource.data.hostId == request.auth.uid
              && ((resource.data.status == 'pending'
                    && request.resource.data.status in ['confirmed', 'rejected'])
                  || (resource.data.status == 'confirmed'
                    && request.resource.data.status == 'checkedIn')
                  || (resource.data.status == 'checkedIn'
                    && request.resource.data.status == 'checkedOut'))));
      allow delete: if false;
    }

    match /room_reservations/{reservationId} {
      allow read: if signedIn();
      allow create, update: if signedIn()
        && request.resource.data.bookingId is string
        && existsAfter(/databases/$(database)/documents/bookings/$(request.resource.data.bookingId))
        && getAfter(/databases/$(database)/documents/bookings/$(request.resource.data.bookingId)).data.guestId == request.auth.uid
        && getAfter(/databases/$(database)/documents/bookings/$(request.resource.data.bookingId)).data.roomId == request.resource.data.roomId;
      allow delete: if false;
    }

    match /reviews/{bookingId} {
      allow read: if true;
      allow create: if signedIn()
        && request.resource.data.bookingId == bookingId
        && request.resource.data.guestId == request.auth.uid
        && request.resource.data.rating is int
        && request.resource.data.rating >= 1
        && request.resource.data.rating <= 5
        && request.resource.data.comment is string
        && request.resource.data.comment.size() > 0
        && exists(/databases/$(database)/documents/bookings/$(bookingId))
        && get(/databases/$(database)/documents/bookings/$(bookingId)).data.guestId == request.auth.uid
        && get(/databases/$(database)/documents/bookings/$(bookingId)).data.status == 'checkedOut';
      allow update, delete: if false;
    }
  }
}
