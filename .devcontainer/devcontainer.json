{
  "name": "Homestay - Flutter 3.35.2",
  "build": { "dockerfile": "Dockerfile" },
  "remoteUser": "vscode",
  "forwardPorts": [8080],
  "portsAttributes": {
    "8080": { "label": "Homestay Flutter Web", "onAutoForward": "notify" }
  },
  "customizations": {
    "vscode": {
      "extensions": ["Dart-Code.dart-code", "Dart-Code.flutter"],
      "settings": { "dart.flutterSdkPath": "/opt/flutter" }
    }
  },
  "postCreateCommand": "flutter config --enable-web && flutter pub get"
}
